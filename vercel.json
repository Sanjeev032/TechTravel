{
  "version": 2,
  "buildCommand": "pnpm run build",
  "builds": [
    {
      "src": "artifacts/namrata-universal/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    },
    {
      "src": "artifacts/api-server/src/app.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/artifacts/api-server/src/app.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/artifacts/namrata-universal/$1"
    }
  ]
}
